# ─── App ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://petid:petid_dev_password@localhost:5432/petid
POSTGRES_PASSWORD=petid_dev_password

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# ─── JWT (CHANGE THESE — minimum 32 chars each) ──────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=change_me_cookie_secret

# ─── Storage (AWS S3 or MinIO) ───────────────────────────────────────
STORAGE_PROVIDER=s3
S3_BUCKET=petid-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio_dev_password
S3_ENDPOINT=http://localhost:9000
CDN_URL=

# ─── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Firebase (Push Notifications) ───────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@petid.app

# ─── OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Next.js Admin ───────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
INTERNAL_API_URL=http://localhost:3000/api/v1

# ─── Mobile (Expo) ────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
